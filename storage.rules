rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── All storage paths ────────────────────────────────────────────────────
    match /{allPaths=**} {
      // Anyone can read (product images, banners, etc. are public)
      allow read: if true;

      // Only authenticated admin can write
      allow write: if
        request.auth != null &&
        // Max file size: 5MB
        request.resource.size <= 5 * 1024 * 1024 &&
        // Only allow images
        request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null;
    }
  }
}
